# ──────────────────────────────────────────────────────────
# Ajker Bazar Dor — API environment variables
# Copy this file to .env and fill in your values.
# All variables marked REQUIRED will cause the API to exit
# on startup if they are missing or invalid.
# ──────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────
# REQUIRED
# For Turso cloud:   libsql://<your-db>.turso.io
# For local dev:     file:./dev.db
TURSO_DATABASE_URL=file:./dev.db

# REQUIRED for Turso cloud; leave empty for local file
TURSO_AUTH_TOKEN=

# ── Auth ───────────────────────────────────────────────────
# REQUIRED — min 32 random characters
JWT_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxxx

# Access token lifetime (default: 15m)
JWT_EXPIRES_IN=15m

# Refresh token lifetime (default: 7d)
JWT_REFRESH_EXPIRES_IN=7d

# ── Seeded admin account ───────────────────────────────────
# REQUIRED — created on first migration if no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated allowed CORS origins
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# ── Storage (product images) ───────────────────────────────
# 'local' stores files in ./uploads/ (dev only)
# 's3' stores files in an S3-compatible bucket (production)
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Public base URL for uploaded images
# For local: http://localhost:3000/uploads
# For S3:    https://your-bucket.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=http://localhost:3000/uploads

# ── Rate limiting ──────────────────────────────────────────
# Login and upload endpoints are more strictly limited
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5
THROTTLE_UPLOAD_LIMIT=10
