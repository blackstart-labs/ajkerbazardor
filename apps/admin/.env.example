# Admin SPA — environment variables
# Copy to .env and adjust

# Base URL of the API (without trailing slash)
VITE_API_BASE=https://your-api.example.com/api/v1

# Local dev proxy target origin. Defaults in code to the deployed API origin for
# frontend-only development. Use http://localhost:3000 when running the API locally.
VITE_API_PROXY_TARGET=http://localhost:3000
